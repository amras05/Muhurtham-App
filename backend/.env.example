# Muhurtham backend settings — TEMPLATE (safe to commit; holds no real values).
# Copy to backend/.env and fill in. backend/.env is git-ignored and must never be committed.
#
# Database: PostgreSQL everywhere.
#   Development  — the shared Supabase project (both laptops), through Supabase's session pooler.
#   Production   — native PostgreSQL on the Hetzner server (values live only on the server).
#
# Read by the app today: MUHURTHAM_SECRET_KEY, MUHURTHAM_CORS_ORIGINS, MUHURTHAM_ENABLE_DEV_PDF.
# The rest are used from accounts-plan step A (database) and step B (OTP).

# ── Environment ───────────────────────────────────────────────
# development | production. Production refuses to start without the secrets below.
MUHURTHAM_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
MUHURTHAM_DB_ENGINE=postgresql
# Supabase: Project → Connect → "Session pooler" host, e.g. aws-0-ap-south-1.pooler.supabase.com
# Production: 127.0.0.1 or the compose service name (db)
MUHURTHAM_DB_HOST=
MUHURTHAM_DB_PORT=5432
MUHURTHAM_DB_NAME=postgres
# Our tables live in this schema (not exposed by Supabase's web API).
MUHURTHAM_DB_SCHEMA=app
# require on Supabase; on the production server use require if the app reaches the DB over a network.
MUHURTHAM_DB_SSLMODE=require
# Supabase only: the pooler logs users in as <user>.<project-ref>. Leave empty in production.
MUHURTHAM_DB_PROJECT_REF=
# App role: SELECT/INSERT/UPDATE/DELETE on schema app only.
MUHURTHAM_DB_APP_USER=muhurtham_app
MUHURTHAM_DB_APP_PASSWORD=
# Migration role: owns the tables (Alembic only). Only the migration owner needs this password.
MUHURTHAM_DB_MIGRATE_USER=muhurtham_migrate
MUHURTHAM_DB_MIGRATE_PASSWORD=
# Connections per server worker (Supabase free tier allows few; 2 laptops x 2 workers x 3 = 12).
MUHURTHAM_DB_POOL_SIZE=3

# ── Security ──────────────────────────────────────────────────
# Must be the SAME on both developer laptops (they share one database). Share once via a
# password manager, never by chat, email or git. Production has its own, different values.
# Signs login tokens. 64 hex characters:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MUHURTHAM_SECRET_KEY=
# Encrypts family birth details. 32 random bytes, base64:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MUHURTHAM_DATA_KEY=

# ── WhatsApp OTP (Meta Cloud API) ─────────────────────────────
MUHURTHAM_WHATSAPP_TOKEN=
MUHURTHAM_WHATSAPP_PHONE_NUMBER_ID=
MUHURTHAM_WHATSAPP_TEMPLATE=otp_verification
# 1 = print OTPs to the console when WhatsApp is not set up. Never 1 in production.
MUHURTHAM_OTP_DEV_ECHO=1

# ── App ───────────────────────────────────────────────────────
MUHURTHAM_ENABLE_DEV_PDF=1
# Comma-separated web origins allowed to call the API from another site.
# Leave unset locally (the web pages are served by the API itself).
# MUHURTHAM_CORS_ORIGINS=https://muhurtham.example.com
