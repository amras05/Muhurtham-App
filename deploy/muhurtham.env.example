# ==============================================================================
# Muhurtham production settings  →  copy to /etc/muhurtham.env on the server
#   sudo cp deploy/muhurtham.env.example /etc/muhurtham.env
#   sudo chown root:deploy /etc/muhurtham.env && sudo chmod 640 /etc/muhurtham.env
#   sudo nano /etc/muhurtham.env        (fill in every empty value)
# Loaded by muhurtham.service (EnvironmentFile) and by the backup, clean-up and deploy steps.
# Use NEW secrets here, never the development ones from backend/.env. Never commit this file.
# ==============================================================================

MUHURTHAM_ENV=production

# ── Database: native PostgreSQL on this server (deploy/setup_database.sh) ─────
MUHURTHAM_DB_HOST=127.0.0.1
MUHURTHAM_DB_PORT=5432
MUHURTHAM_DB_NAME=muhurtham
MUHURTHAM_DB_SCHEMA=app
# Local connection over the loopback interface: no TLS needed.
MUHURTHAM_DB_SSLMODE=disable
MUHURTHAM_DB_APP_USER=muhurtham_app
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MUHURTHAM_DB_APP_PASSWORD=
MUHURTHAM_DB_MIGRATE_USER=muhurtham_migrate
MUHURTHAM_DB_MIGRATE_PASSWORD=
MUHURTHAM_DB_POOL_SIZE=3

# ── Keys (new for production) ─────────────────────────────────────────────────
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MUHURTHAM_SECRET_KEY=
# Encrypts family birth details. 32 random bytes, base64. Keep a copy in your password manager:
# if it is lost, saved birth details can't be opened (the stars still work).
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MUHURTHAM_DATA_KEY=

# ── Plain HTTP by IP address (no domain yet) ──────────────────────────────────
# 0 = login cookies work over http://<server-ip>. KNOWN RISK: passwords and login cookies travel
# unencrypted. Set to 1 (or delete the line) as soon as the site has a domain and HTTPS.
MUHURTHAM_COOKIE_SECURE=0

# ── WhatsApp login codes (Meta Cloud API) ─────────────────────────────────────
MUHURTHAM_WHATSAPP_TOKEN=
MUHURTHAM_WHATSAPP_PHONE_NUMBER_ID=
MUHURTHAM_WHATSAPP_TEMPLATE=otp_verification
# Never 1 in production: it would print login codes into the server log.
MUHURTHAM_OTP_DEV_ECHO=0

# ── Backups (deploy/backup.sh) ────────────────────────────────────────────────
MUHURTHAM_BACKUP_DIR=/var/backups/muhurtham
MUHURTHAM_BACKUP_KEEP_DAYS=14
# Off-server copy (decision H2, still open). Example for a Hetzner Storage Box:
#   MUHURTHAM_BACKUP_REMOTE=u123456@u123456.your-storagebox.de:muhurtham
# Empty = backups stay on this server only (a lost server loses them too).
MUHURTHAM_BACKUP_REMOTE=
