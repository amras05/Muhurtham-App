[Unit]
Description=Muhurtham FastAPI Application (Native)
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/muhurtham/backend
Environment="PATH=/var/www/muhurtham/.venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PORT=8000"
Environment="MUHURTHAM_WORKERS=2"
# Database, keys, WhatsApp and MUHURTHAM_COOKIE_SECURE (see deploy/muhurtham.env.example).
EnvironmentFile=/etc/muhurtham.env
ExecStart=/var/www/muhurtham/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
